model OpeningBalance {
  id              Int             @id @default(autoincrement())
  itemCode        String          @map("item_code") @db.NVarChar(50)
  itemName        String          @map("item_name") @db.NVarChar(255)
  warehouse       String          @map("warehouse") @db.NVarChar(50)
  stock           Decimal         @default(0, map: "DF_opening_balance_stock") @map("stock") @db.Decimal(15, 2)
  stockValue      Decimal         @default(0, map: "DF_opening_balance_stock_value") @map("stock_value") @db.Decimal(15, 2)
  // Stock Value = Stock x Unit Cost. unitCost is the DLP (Dealer/Distributor
  // Price List) price the page fills in for the item (editable only when the
  // item has no DLP price). openingBalanceAccount is the header's Opening
  // Balance Account -- the credit side of the journal entry this document
  // posts (Dr Inventory per item / Cr this account); stamped on every line of
  // the document like documentNumber is.
  unitCost        Decimal         @default(0, map: "DF_opening_balance_unit_cost") @map("unit_cost") @db.Decimal(18, 4)
  // Batch | Serial | Standard. Only Batch carries a batchNo (and requires one).
  manageBy        String?         @map("manage_by") @db.NVarChar(20)
  openingBalanceAccount String?   @map("opening_balance_account") @db.NVarChar(20)
  status          String          @default("N'Active'", map: "DF_opening_balance_status") @db.NVarChar(20)
  createdAt       DateTime        @default(now(), map: "DF_opening_balance_created_at") @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  documentNumber  String?         @map("document_number") @db.NVarChar(50)
  documentDate    DateTime?       @map("document_date") @db.Date
  termsConditions String?         @map("terms_conditions") @db.NVarChar(Max)
  preparedBy      String?         @map("prepared_by") @db.NVarChar(150)
  approvedBy      String?         @map("approved_by") @db.NVarChar(150)
  // Batch tracking for a Batch-managed item's opening stock. Until now the
  // only place that ever created a ProductBatch row was Purchase GRN's
  // "Batches - Setup" dialog, so a Batch-tracked item's STARTING stock had
  // nowhere to register a batch number -- Delivery Challan/Stock Issue's own
  // "Batches Number - Selection" dialog could only ever offer batches a GRN
  // had created, never an opening position. batchNo is required (enforced
  // in the /opening-balance/batch and /opening-balance/:id routes, by
  // looking up the item's Product Master "Manage Item By") when the item is
  // Batch-tracked, and left null otherwise -- same optional/required split
  // GRN's own batches carry.
  batchNo         String?         @map("batch_no") @db.NVarChar(100)
  // Tracks which generation of this row's position is currently posted to
  // [dbo].[Stock] -- same reverse-then-repost pattern used by syncStockPosting
  // in routes/resources.js (0 = never posted). A bulk createMany import has
  // no way to set this per row at insert time, so freshly-created rows start
  // at the column default (0) and get their first posting generation (1) the
  // same way an edit's repost does.
  stockPostingGeneration Int?      @default(0, map: "DF_opening_balance_stock_posting_generation") @map("stock_posting_generation")
  warehouseRef    WarehouseMaster @relation(fields: [warehouse], references: [whsCode])

  // Duplicates are allowed: the same item / warehouse / batch may appear on
  // several lines and in several documents, so this is a plain (non-unique)
  // lookup index. Rows are addressed by id.
  @@index([itemCode, warehouse, batchNo], map: "IX_opening_balance_item_warehouse_batch")
  @@map("opening_balance")
}

model BusinessPartnerOpeningBalance {
  id                    Int       @id(map: "PK_business_partner_opening_balances") @default(autoincrement())
  documentNumber        String    @map("document_number") @db.NVarChar(50)
  documentDate          DateTime? @map("document_date") @db.Date
  openingBalanceAccount String    @map("opening_balance_account") @db.NVarChar(20)
  ref1                  String?   @map("ref_1") @db.NVarChar(50)
  ref2                  String?   @map("ref_2") @db.NVarChar(50)
  bpType                String    @map("bp_type") @db.NVarChar(20)
  remarks               String?   @db.NVarChar(Max)
  bpCode                String    @map("bp_code") @db.NVarChar(50)
  bpName                String    @map("bp_name") @db.NVarChar(150)
  // Per-line invoice reference (all optional) -- see migration
  // 20260930190000_bp_opening_balance_invoice_fields.
  invoiceNo             String?   @map("invoice_no") @db.NVarChar(50)
  invoiceDate           DateTime? @map("invoice_date") @db.Date
  dueDate               DateTime? @map("due_date") @db.Date
  openingBalance        Decimal   @default(0, map: "DF_bp_opening_balances_opening_balance") @map("opening_balance") @db.Decimal(15, 2)
  status                String    @default("Posted", map: "DF_bp_opening_balances_status") @db.NVarChar(20)
  createdAt             DateTime  @default(now(), map: "DF_bp_opening_balances_created_at") @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([bpCode], map: "IX_bp_opening_balances_bp_code")
  @@index([documentNumber], map: "IX_bp_opening_balances_document_number")
  @@index([status], map: "IX_bp_opening_balances_status")
  @@index([documentDate], map: "IX_bp_opening_balances_document_date")
  // bpName/ref1 round out GET /business-partner-opening-balance's own OR
  // search (documentNumber/bpCode/bpName/ref1 — see that route) with the
  // same single-column-per-predicate pattern as bp_code/document_number/
  // status/document_date above, added in 20260918190001. These two don't
  // speed up the CONTAINS itself — SQL Server can't index-seek a
  // leading-wildcard LIKE '%term%' no matter what's indexed — but they keep
  // ORDER BY/COUNT and an exact-match/sort on either column fast, and cost
  // nothing on a table this write-light. See migration
  // 20260919030000_add_bp_opening_balance_search_indexes.
  @@index([bpName], map: "IX_bp_opening_balances_bp_name")
  @@index([ref1], map: "IX_bp_opening_balances_ref_1")
  @@map("business_partner_opening_balances")
}

