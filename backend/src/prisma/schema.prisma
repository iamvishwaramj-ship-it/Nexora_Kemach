model BatchAllocation {
  id                       Int                     @id(map: "PK_batch_allocations") @default(autoincrement())
  batchNo                  String                  @map("batch_no") @db.NVarChar(100)
  productCode              String                  @map("product_code") @db.NVarChar(50)
  quantity                 Decimal                 @default(0, map: "DF_batch_allocations_quantity") @db.Decimal(15, 2)
  deliveryChallanItemId    Int?                    @map("delivery_challan_item_id")
  stockIssueItemId         Int?                    @map("stock_issue_item_id")
  createdAt                DateTime                @default(now(), map: "DF_batch_allocations_created_at") @map("created_at")
  purchaseReturnItemId     Int?                    @map("purchase_return_item_id")
  purchaseCreditMemoItemId Int?                    @map("purchase_credit_memo_item_id")
  salesReturnItemId        Int?                    @map("sales_return_item_id")
  salesCreditMemoItemId    Int?                    @map("sales_credit_memo_item_id")
  stockTransferItemId      Int?                    @map("stock_transfer_item_id")
  // Sales Invoice, when it is the direct (no base Delivery Challan) document,
  // SELECTS existing batches exactly like Delivery Challan/Stock Issue do —
  // see assertBatchSerialIssueAllocation/assertBatchSerialAvailability calls
  // in the Sales Invoice routes.
  salesInvoiceItemId       Int?                    @map("sales_invoice_item_id")
  // Stock Adjustment (Decrease lines) takes batch quantity automatically, earliest
  // expiry first, and records what it took here so an edit or delete can give it
  // back -- see autoAllocateBatchShortfall in utils/businessRules.js.
  stockAdjustmentItemId    Int?                    @map("stock_adjustment_item_id")
  deliveryChallanItem      DeliveryChallanItem?    @relation(fields: [deliveryChallanItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_batch_allocations_delivery_challan_item")
  purchaseCreditMemoItem   PurchaseCreditMemoItem? @relation(fields: [purchaseCreditMemoItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_batch_allocations_purchase_credit_memo_item")
  purchaseReturnItem       PurchaseReturnItem?     @relation(fields: [purchaseReturnItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_batch_allocations_purchase_return_item")
  salesCreditMemoItem      SalesCreditMemoItem?    @relation(fields: [salesCreditMemoItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_batch_allocations_sales_credit_memo_item")
  salesReturnItem          SalesReturnItem?        @relation(fields: [salesReturnItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_batch_allocations_sales_return_item")
  stockIssueItem           StockIssueItem?         @relation(fields: [stockIssueItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_batch_allocations_stock_issue_item")
  stockTransferItem        StockTransferItem?      @relation(fields: [stockTransferItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_batch_allocations_stock_transfer_item")
  salesInvoiceItem         SalesInvoiceItem?       @relation(fields: [salesInvoiceItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_batch_allocations_sales_invoice_item")
  stockAdjustmentItem      StockAdjustmentItem?    @relation(fields: [stockAdjustmentItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_batch_allocations_stock_adjustment_item")

  @@index([batchNo], map: "IX_batch_allocations_batch_no")
  @@map("batch_allocations")
}

