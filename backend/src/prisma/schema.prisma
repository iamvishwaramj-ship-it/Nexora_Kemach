// Renamed to a SAP-style source-document-linking layout: TransNum/TransType
// (an internal id plus a label) become BaseEntry/BaseType/BaseNum/BaseLine --
// the source document's internal id, its type, its human-readable display
// number, and the specific line within it -- and the old single MAV_COST
// column becomes ItemCost. See each field's own comment for what changed and
// why; utils/stockTable.js (the only writer) and utils/stockValuation.js /
// utils/productInventory.js (the readers) were updated together with this.
// Exact column layout and order requested: LogEntry, BaseEntry, BaseNum,
// BaseType, BaseLine, ItemId, ItemCode, ItemName, Warehouse, InQty, OutQty,
// StockPrice, Currency, CreatedBy, CreateDate, CreateTime, ItemCost,
// PostGeneration -- no FifoCost, no TransValue (both dropped; see the new
// migration for what that costs: FifoCost's prior column had real FIFO-cost
// history that this migration deletes on purpose, per explicit confirmation).
model Stock {
  // The row's own id, distinct from BaseEntry below (the SOURCE DOCUMENT's
  // id). Still just an autoincrementing primary key.
  logEntry   BigInt    @id(map: "PK_OINM") @default(autoincrement()) @map("LogEntry")
  // The source document's own internal database id (its `id` column), e.g.
  // the row id of the Sales Invoice or Purchase GRN this line came from.
  baseEntry  Int       @map("BaseEntry")
  // The source document's human-readable display number (its
  // grnNo/invoiceNo/challanNo/... ), e.g. 'GRN-8812' or 'INV-2026-0042'.
  // Nullable because rows written before this column existed, and any
  // caller not yet updated to supply it, simply have no display number
  // recorded -- BaseEntry alone is still enough to look the document up.
  baseNum    String?   @map("BaseNum") @db.NVarChar(50)
  // A descriptive string label (e.g. 'Purchase GRN', 'Sales Invoice
  // Reversal'), not a numeric code: reversal detection (isReversalType in
  // utils/stockTable.js) depends on suffix matching on this string, and
  // TRANS_TYPES elsewhere in the app already uses these exact labels.
  baseType   String    @default("N'Unknown'", map: "DF_Stock_TransType") @map("BaseType") @db.NVarChar(50)
  // The line's position within the batch of rows this posting wrote
  // (1-based), which in practice is also this line's position on the
  // source document.
  baseLine   Int?      @map("BaseLine")
  itemId     Int       @map("ItemId")
  itemCode   String    @map("ItemCode") @db.NVarChar(50)
  // The product name, cached on the row at posting time so historical
  // reports keep the name as it was then.
  itemName   String?   @map("ItemName") @db.NVarChar(200)
  warehouse  String?   @map("Warehouse") @db.NVarChar(150)
  // Added directly on the live table (VarChar(100)) -- the branch the
  // movement belongs to, cached from the source document the same way
  // ItemName is, so a historical row keeps the branch it was posted under.
  branch     String?   @map("Branch") @db.VarChar(100)
  inQty      Decimal   @default(0, map: "DF_Stock_InQty") @map("InQty") @db.Decimal(19, 6)
  outQty     Decimal   @default(0, map: "DF_Stock_OutQty") @map("OutQty") @db.Decimal(19, 6)
  // The unit price stated on the source document line.
  stockPrice Decimal?  @map("StockPrice") @db.Decimal(19, 6)
  currency   String?   @map("Currency") @db.NVarChar(3)
  createdBy  Int?      @map("CreatedBy")
  createDate DateTime? @map("CreateDate") @db.Date
  createTime DateTime? @map("CreateTime") @db.Time
  // The valuation unit cost at the moment this line posted -- FIFO or
  // Moving Average, whichever the product's Calculation Method uses (see
  // isCosted/costMovement in utils/stockValuation.js). The two methods are
  // mutually exclusive per product, so one column is enough; null for a
  // product on neither costed method.
  itemCost   Decimal?  @map("ItemCost") @db.Decimal(19, 6)
  // Which edit-cycle of the source document produced this row. The journal
  // never updates or deletes a row (see the header comment on this model's
  // usage in utils/stockTable.js), so when an already-posted document is
  // edited, the fix is not to touch these rows but to write a reversal of
  // the OLD generation and a fresh post under a NEW generation number --
  // this column is what lets hasPostedAlready() tell those apart instead of
  // seeing "a row already exists for this BaseType/BaseEntry" and skipping
  // the new post entirely. Defaults to 1 so every row written before this
  // column existed is simply generation 1, same as a document's first post.
  postGeneration Int   @default(1, map: "DF_Stock_PostGeneration") @map("PostGeneration")

  @@index([baseType, baseEntry], map: "IX_Stock_BaseType_BaseEntry")
  @@index([itemCode, warehouse], map: "IX_Stock_ItemCode_Warehouse")
  @@map("Stock")
}

