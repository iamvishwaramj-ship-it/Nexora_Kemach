model PurchaseInvoice {
  id                 Int                   @id @default(autoincrement())
  invoiceNo          String                @unique @map("invoice_no") @db.NVarChar(50)
  supplier           String?               @db.NVarChar(100)
  invoiceDate        DateTime?             @map("invoice_date") @db.Date
  grnNo              String?               @map("grn_no") @db.NVarChar(50)
  poNo               String?               @map("po_no") @db.NVarChar(50)
  // Vendor's own reference for this invoice — same field/name as every
  // other purchase document's own vendorRefNo (see
  // PurchaseOtherDetailsCard.jsx).
  vendorRefNo        String?               @map("vendor_ref_no") @db.NVarChar(50)
  currency           String                @default("N'INR'", map: "DF_purchase_invoices_currency") @db.NVarChar(10)
  paymentTerms       String?               @map("payment_terms") @db.NVarChar(50)
  dueDate            DateTime?             @map("due_date") @db.Date
  placeOfSupply      String?               @map("place_of_supply") @db.NVarChar(100)
  billFrom           String?               @map("bill_from") @db.NVarChar(Max)
  // Display-only, auto-filled from the selected supplier's own Business
  // Partner record — see supplierState in PurchaseInvoice.jsx. Independent
  // of placeOfSupply above, which tracks a different concept.
  supplierState      String?               @map("supplier_state") @db.NVarChar(100)
  shipTo             String?               @map("ship_to") @db.NVarChar(Max)
  // "Ship to a different customer" toggle on the Supplier & Document
  // Details card. Off (default) leaves shipTo deriving from the selected
  // Branch, same as before this feature existed. On, shipTo instead holds
  // whatever Shipping-Address text was resolved from shipToCustomer's
  // Business Partner record (or since edited by hand) -- either way shipTo
  // itself is always the final, already-resolved text the print template
  // reads; these two columns exist only so the form can correctly re-show
  // which mode was used, and which customer, when the invoice is reopened
  // for edit.
  shipToDifferentCustomer Boolean          @default(false, map: "DF_purchase_invoices_ship_to_diff_customer") @map("ship_to_different_customer")
  // Same shape as `supplier` above: the Business Partner's name, not a
  // numeric id -- every CFL field in this app (Supplier here, Customer on
  // the Sales side) stores the party's name as its value, so this matches
  // that convention rather than introducing an id-keyed lookup just for
  // this one field. Not re-validated against BusinessPartner on save, same
  // as `supplier` isn't either.
  shipToCustomer     String?               @map("ship_to_customer") @db.NVarChar(100)
  notes              String?               @db.NVarChar(Max)
  termsConditions    String?               @map("terms_conditions") @db.NVarChar(Max)
  attachmentName     String?               @map("attachment_name") @db.NVarChar(255)
  discountPercent    Decimal               @default(0, map: "DF_purchase_invoices_discount_percent") @map("discount_percent") @db.Decimal(5, 2)
  subtotal           Decimal               @default(0, map: "DF_purchase_invoices_subtotal") @db.Decimal(15, 2)
  taxableAmount      Decimal               @default(0, map: "DF_purchase_invoices_taxable_amount") @map("taxable_amount") @db.Decimal(15, 2)
  cgstAmount         Decimal               @default(0, map: "DF_purchase_invoices_cgst_amount") @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount         Decimal               @default(0, map: "DF_purchase_invoices_sgst_amount") @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount         Decimal               @default(0, map: "DF_purchase_invoices_igst_amount") @map("igst_amount") @db.Decimal(15, 2)
  roundOff           Decimal               @default(0, map: "DF_purchase_invoices_round_off") @map("round_off") @db.Decimal(15, 2)
  amount             Decimal               @default(0, map: "DF_purchase_invoices_amount") @db.Decimal(15, 2)
  status             String                @default("N'Draft'", map: "DF_purchase_invoices_status") @db.NVarChar(50)
  // Cancel action (Actions column, with a confirm popup) — same
  // pattern/reasoning as PurchaseOrder.isCancelled. Set together with
  // status: "Cancelled" and never on its own. Refused by the cancel route
  // while any payment is settled against this invoice or a Purchase Credit
  // Memo already references it — see PATCH /purchase/invoices/:id/cancel.
  // Once true: excluded from every Copy From / "pick a source document"
  // picker downstream (see copyableInvoices in PurchaseCreditMemo.jsx), and
  // View/Edit/Print/Delete are blocked for it in the UI.
  isCancelled        Boolean               @default(false, map: "DF_purchase_invoices_is_cancelled") @map("is_cancelled")
  // See the identical comment on GoodsReceivedNote.stockPostingGeneration --
  // relevant here only for a DIRECT invoice (no grnNo); one linked to a GRN
  // never posts stock itself, so this stays 0 for it.
  stockPostingGeneration Int?              @default(0, map: "DF_purchase_invoices_stock_posting_generation") @map("stock_posting_generation")
  paymentStatus      String                @default("N'Unpaid'", map: "DF_purchase_invoices_payment_status") @map("payment_status") @db.NVarChar(50)
  branch             String?               @db.NVarChar(150)
  warehouse          String?               @db.NVarChar(150)
  billingType        String?               @map("billing_type") @db.NVarChar(20)
  purchaseType       String?               @map("purchase_type") @db.NVarChar(20)
  typeOfPurchase     String?               @map("type_of_purchase") @db.NVarChar(50)
  salesType          String?               @map("sales_type") @db.NVarChar(20)
  purchaseEmployee   String?               @map("purchase_employee") @db.NVarChar(100)
  transportMode      String?               @map("transport_mode") @db.NVarChar(50)
  invoiceType        String?               @map("invoice_type") @db.NVarChar(150)
  tcsAmount          Decimal               @default(0, map: "DF_purchase_invoices_tcs_amount") @map("tcs_amount") @db.Decimal(15, 2)
  preparedBy         String?               @map("prepared_by") @db.NVarChar(100)
  approvedBy         String?               @map("approved_by") @db.NVarChar(100)
  roadTax            Decimal               @default(0, map: "DF_purchase_invoices_road_tax") @map("road_tax") @db.Decimal(15, 2)
  freightTransportId Int?                  @map("freight_transport_id")
  freightName        String?               @map("freight_name") @db.NVarChar(150)
  freightRemarks     String?               @map("freight_remarks") @db.NVarChar(Max)
  freightTaxCodeId   Int?                  @map("freight_tax_code_id")
  freightTaxAmount   Decimal               @default(0, map: "DF_purchase_invoices_freight_tax_amount") @map("freight_tax_amount") @db.Decimal(15, 2)
  freightNetAmount   Decimal               @default(0, map: "DF_purchase_invoices_freight_net_amount") @map("freight_net_amount") @db.Decimal(15, 2)
  freightGrossAmount Decimal               @default(0, map: "DF_purchase_invoices_freight_gross_amount") @map("freight_gross_amount") @db.Decimal(15, 2)
  items              PurchaseInvoiceItem[]

  @@index([supplier])
  @@index([branch, status], map: "ix_purchase_invoice_branch_status")
  @@index([invoiceDate, status], map: "ix_purchase_invoice_date_status")
  @@index([grnNo, status, invoiceDate], map: "ix_purchase_invoices_direct")
  @@index([status, invoiceDate], map: "IX_PurchaseInvoice_Status_InvoiceDate")
  @@index([supplier], map: "IX_PurchaseInvoice_Supplier")
  @@index([poNo])
  @@map("purchase_invoices")
}

