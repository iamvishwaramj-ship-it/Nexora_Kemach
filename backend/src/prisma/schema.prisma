generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model AppUser {
  id                            Int                    @id @default(autoincrement())
  name                          String                 @db.NVarChar(100)
  email                         String?                @db.NVarChar(100)
  passwordHash                  String                 @map("password_hash") @db.NVarChar(255)
  role                          String                 @default("N'admin'", map: "DF_app_users_role") @db.NVarChar(50)
  status                        String                 @default("N'Active'", map: "DF_app_users_status") @db.NVarChar(20)
  profilePhotoUrl               String?                @map("profile_photo_url") @db.NVarChar(500)
  userCode                      String                 @unique @map("user_code") @db.NVarChar(50)
  employeeId                    Int?                   @map("employee_id")
  employeeCode                  String?                @map("employee_code") @db.NVarChar(50)
  employeeName                  String?                @map("employee_name") @db.NVarChar(150)
  employee                      SalesEmployee?         @relation(fields: [employeeId], references: [id], onUpdate: NoAction)
  notifications                 Notification[]
  refreshTokens                 RefreshToken[]
  approvedStockTransferRequests StockTransferRequest[] @relation("StockTransferRequestApprover")
  createdStockTransferRequests  StockTransferRequest[] @relation("StockTransferRequestCreator")
  branches                      UserBranch[]
  permissions                   UserPermission[]

  @@map("app_users")
}

model Notification {
  id            Int      @id(map: "PK_notifications") @default(autoincrement())
  userId        Int      @map("user_id")
  type          String   @db.NVarChar(50)
  title         String   @db.NVarChar(200)
  message       String?  @db.NVarChar(Max)
  referenceType String   @map("reference_type") @db.NVarChar(50)
  referenceId   Int      @map("reference_id")
  status        String   @default("Unread", map: "DF_notifications_status") @db.NVarChar(20)
  actionStatus  String?  @map("action_status") @db.NVarChar(20)
  createdAt     DateTime @default(dbgenerated("sysutcdatetime()"), map: "DF_notifications_created_at") @map("created_at")
  user          AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_notifications_user")

  @@index([userId, status])
  @@index([referenceType, referenceId, type], map: "notifications_reference_type_reference_id_type_idx")
  @@map("notifications")
}

model UserPermission {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  menuKey   String  @map("menu_key") @db.NVarChar(100)
  canView   Boolean @default(false, map: "DF_user_permissions_can_view") @map("can_view")
  canAdd    Boolean @default(false, map: "DF_user_permissions_can_add") @map("can_add")
  canEdit   Boolean @default(false, map: "DF_user_permissions_can_edit") @map("can_edit")
  canDelete Boolean @default(false, map: "DF_user_permissions_can_delete") @map("can_delete")
  // Cancel action on Purchase/Sales documents (the row-level Cancel icon).
  // Its own flag so cancelling no longer rides on canEdit. See migration
  // 20261001100000_add_user_permission_can_cancel (backfilled from canEdit).
  canCancel Boolean @default(false, map: "DF_user_permissions_can_cancel") @map("can_cancel")
  // Receives in-app notifications raised by this menu's documents (Stock
  // Transfer Request today). An extra flag on top of View/Add/Edit/Delete --
  // a row with ONLY canNotify is not menu access. Admins ignore it (they are
  // always notified); see utils/approverResolution.js.
  canNotify Boolean @default(false, map: "DF_user_permissions_can_notify") @map("can_notify")
  // JSON array of report column keys this user may NOT see on this menu's
  // report (see frontend/src/lib/reportColumns.js). NULL = all columns.
  hiddenColumns String? @map("hidden_columns") @db.NVarChar(Max)
  user      AppUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, menuKey], map: "UQ_UserPermission_User_MenuKey")
  @@map("user_permissions")
}

model UserBranch {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  branchId  Int     @map("branch_id")
  isDefault Boolean @default(false, map: "DF_user_branches_is_default") @map("is_default")
  user      AppUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // Lets authService.js's grantedBranches() include { branch: { select: {
  // branchName, status } } } — branchId was a plain scalar column with no
  // Prisma relation to Branch, so that include threw "Unknown field 'branch'"
  // and every login failed outright (not just a permissions gap).
  branch    Branch  @relation(fields: [branchId], references: [id], onUpdate: NoAction)

  @@unique([userId, branchId], map: "UQ_UserBranch_User_Branch")
  @@map("user_branches")
}

model CompanyDetails {
  id                 Int     @id @default(autoincrement())
  companyName        String? @map("company_name") @db.NVarChar(200)
  legalName          String? @map("legal_name") @db.NVarChar(200)
  registrationNumber String? @map("registration_number") @db.NVarChar(100)
  tinNumber          String? @map("tin_number") @db.NVarChar(50)
  gstin              String? @db.NVarChar(50)
  pan                String? @db.NVarChar(20)
  hsnNo              String? @map("hsn_no") @db.NVarChar(50)
  currency           String  @default("N'INR'", map: "DF_company_details_currency") @db.NVarChar(10)
  phone              String? @db.NVarChar(20)
  email              String? @db.NVarChar(100)
  website            String? @db.NVarChar(150)
  address            String? @db.NVarChar(Max)
  country            String? @db.NVarChar(100)
  state              String? @db.NVarChar(100)
  city               String? @db.NVarChar(100)
  pincode            String? @db.NVarChar(20)
  logoKey            String? @map("logo_key") @db.NVarChar(500)

  @@map("company_details")
}

// Settings > "E-Invoice / E-Way Bill Settings" card — singleton like
// CompanyDetails above (one row for the whole org). Deliberately holds only
// the non-secret half of the TaxPro GSP config: ASP Password and both
// e-invoice Passwords are NOT columns here — they stay in .env
// (TAXPRO_ASP_PASSWORD / TAXPRO_PASSWORD / TAXPRO_PRODUCTION_PASSWORD) and
// are read directly by services/taxproGsp.service.js, never round-tripped
// through this table or the API. See that service's loadConfig() for how
// this row and those env vars are merged at call time.
model EInvoiceSettings {
  id                 Int      @id @default(autoincrement())
  enabled            Boolean  @default(false, map: "DF_einvoice_settings_enabled")
  environment        String   @default("N'sandbox'", map: "DF_einvoice_settings_environment") @db.NVarChar(20)
  sandboxApiUrl      String?  @map("sandbox_api_url") @db.NVarChar(300)
  productionApiUrl   String?  @map("production_api_url") @db.NVarChar(300)
  qrCodeSize         Int      @default(300, map: "DF_einvoice_settings_qr_code_size") @map("qr_code_size")
  aspId              String?  @map("asp_id") @db.NVarChar(50)
  sandboxGstin       String?  @map("sandbox_gstin") @db.NVarChar(15)
  sandboxUsername    String?  @map("sandbox_username") @db.NVarChar(100)
  productionGstin    String?  @map("production_gstin") @db.NVarChar(15)
  productionUsername String?  @map("production_username") @db.NVarChar(100)

  @@map("einvoice_settings")
}

// Settings > "Module Settings" -- singleton (one row for the whole org),
// same pattern as CompanyDetails/EInvoiceSettings above. Three global
// switches read by utils/systemSettings.js: assertModuleEnabled() gates
// opening/saving/posting a Sales or Purchase document (see the moduleGate()
// middleware wired onto those routes in routes/resources.js), and
// isInventoryModuleEnabled() gates every stock-quantity check and
// [dbo].[Stock] write for EVERY document that moves stock -- see
// assertNoNegativeStock/assertNoNegativeWarehouseStock*/postStockEntries's
// own comments for why this is a single choke point rather than a
// per-document flag. All three default to true so a fresh install (or an
// existing database applying this migration) behaves exactly as it did
// before this feature existed until someone deliberately switches a module
// off in Settings.
model SystemSettings {
  id                 Int     @id @default(autoincrement())
  isSalesEnabled     Boolean @default(true, map: "DF_system_settings_is_sales_enabled") @map("is_sales_enabled")
  isPurchaseEnabled  Boolean @default(true, map: "DF_system_settings_is_purchase_enabled") @map("is_purchase_enabled")
  isInventoryEnabled Boolean @default(true, map: "DF_system_settings_is_inventory_enabled") @map("is_inventory_enabled")

  @@map("system_settings")
}

model Branch {
  id                Int             @id @default(autoincrement())
  branchCode        String          @unique @map("branch_code") @db.NVarChar(50)
  branchName        String          @map("branch_name") @db.NVarChar(100)
  address           String?         @db.NVarChar(Max)
  phone             String?         @db.NVarChar(20)
  email             String?         @db.NVarChar(100)
  country           String?         @db.NVarChar(100)
  state             String?         @db.NVarChar(100)
  city              String?         @db.NVarChar(100)
  zipCode           String?         @map("zip_code") @db.NVarChar(20)
  isDefault         Boolean         @default(false, map: "DF_branches_is_default") @map("is_default")
  status            String          @default("N'Active'", map: "DF_branches_status") @db.NVarChar(20)
  streetNo          String?         @map("street_no") @db.NVarChar(50)
  buildingFloorRoom String?         @map("building_floor_room") @db.NVarChar(150)
  block             String?         @db.NVarChar(100)
  defaultWarehouse  String?         @map("default_warehouse") @db.NVarChar(50)
  defaultCustomer   String?         @map("default_customer") @db.NVarChar(100)
  defaultVendor     String?         @map("default_vendor") @db.NVarChar(100)
  employees         SalesEmployee[]
  userBranches      UserBranch[]

  @@map("branches")
}

model FinancialYear {
  id                      Int                     @id @default(autoincrement())
  financialYearName       String                  @map("financial_year_name") @db.NVarChar(50)
  startDate               DateTime?               @map("start_date") @db.Date
  endDate                 DateTime?               @map("end_date") @db.Date
  status                  String                  @default("N'Active'", map: "DF_financial_years_status") @db.NVarChar(20)
  numberingSeries         DocumentNumbering[]
  GLAccountDeterminations GlAccountDetermination?

  @@map("financial_years")
}

model TaxCode {
  id                    Int       @id @default(autoincrement())
  taxCode               String    @unique @map("tax_code") @db.NVarChar(50)
  taxName               String    @map("tax_name") @db.NVarChar(100)
  taxType               String?   @map("tax_type") @db.NVarChar(50)
  taxRate               Decimal?  @map("tax_rate") @db.Decimal(5, 2)
  cgst                  Decimal?  @db.Decimal(5, 2)
  sgst                  Decimal?  @db.Decimal(5, 2)
  igst                  Decimal?  @db.Decimal(5, 2)
  description           String?   @db.NVarChar(Max)
  status                String    @default("N'Active'", map: "DF_tax_codes_status") @db.NVarChar(20)
  sales_account_id      Int?
  purchase_account_id   Int?
  effectiveFrom         DateTime? @map("effective_from") @db.Date
  sgstSalesAccountId    Int?      @map("sgst_sales_account_id")
  sgstPurchaseAccountId Int?      @map("sgst_purchase_account_id")
  sgstRcmAccountId      Int?      @map("sgst_rcm_account_id")
  cgstSalesAccountId    Int?      @map("cgst_sales_account_id")
  cgstPurchaseAccountId Int?      @map("cgst_purchase_account_id")
  cgstRcmAccountId      Int?      @map("cgst_rcm_account_id")
  igstSalesAccountId    Int?      @map("igst_sales_account_id")
  igstPurchaseAccountId Int?      @map("igst_purchase_account_id")
  igstRcmAccountId      Int?      @map("igst_rcm_account_id")
  tcsSalesAccountId     Int?      @map("tcs_sales_account_id")
  tcsPurchaseAccountId  Int?      @map("tcs_purchase_account_id")
  tcsRcmAccountId       Int?      @map("tcs_rcm_account_id")

  @@map("tax_codes")
}

model DocumentNumbering {
  id                Int            @id @default(autoincrement())
  documentCode      String         @map("document_code") @db.NVarChar(30)
  documentName      String         @map("document_name") @db.NVarChar(100)
  seriesName        String         @map("series_name") @db.NVarChar(100)
  isDefault         Boolean        @default(false, map: "DF_document_numbering_is_default") @map("is_default")
  financialYearId   Int?           @map("financial_year_id")
  fyCode            String?        @map("fy_code") @db.NVarChar(20)
  prefix            String?        @db.NVarChar(20)
  suffix            String?        @db.NVarChar(20)
  separator         String         @default("N'-'", map: "DF_document_numbering_separator") @db.NVarChar(5)
  includeFyInNumber Boolean        @default(true, map: "DF_document_numbering_include_fy_in_number") @map("include_fy_in_number")
  numberLength      Int            @default(6, map: "DF_document_numbering_number_length") @map("number_length")
  startNumber       Int            @default(1, map: "DF_document_numbering_start_number") @map("start_number")
  currentNumber     Int?           @map("current_number")
  nextNumber        Int            @map("next_number")
  endNumber         Int            @default(999999, map: "DF_document_numbering_end_number") @map("end_number")
  resetEveryFy      Boolean        @default(true, map: "DF_document_numbering_reset_every_fy") @map("reset_every_fy")
  autoGenerate      Boolean        @default(true, map: "DF_document_numbering_auto_generate") @map("auto_generate")
  manualEntry       Boolean        @default(false, map: "DF_document_numbering_manual_entry") @map("manual_entry")
  status            String         @default("N'Active'", map: "DF_document_numbering_status") @db.NVarChar(20)
  lastNumberAt      DateTime?      @map("last_number_at")
  createdAt         DateTime       @default(now(), map: "DF_document_numbering_created_at") @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  financialYear     FinancialYear? @relation(fields: [financialYearId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([documentCode, financialYearId, seriesName], map: "document_numbering_code_fy_name_key")
  @@index([documentCode, status], map: "document_numbering_code_status_idx")
  @@index([financialYearId], map: "document_numbering_fy_idx")
  @@index([documentCode, financialYearId, isDefault], map: "document_numbering_default_idx")
  @@map("document_numbering")
}

model BankName {
  id       Int     @id @default(autoincrement())
  bankName String  @unique @map("bank_name") @db.NVarChar(150)
  status   String  @default("N'Active'", map: "DF_bank_names_status") @db.NVarChar(20)
  bankCode String? @map("bank_code") @db.NVarChar(50)

  @@map("bank_names")
}

model HouseBank {
  id             Int       @id @default(autoincrement())
  bankName       String    @map("bank_name") @db.NVarChar(150)
  accountNumber  String    @map("account_number") @db.NVarChar(50)
  accountName    String?   @map("account_name") @db.NVarChar(150)
  ifscCode       String?   @map("ifsc_code") @db.NVarChar(20)
  bankAddress    String?   @map("bank_address") @db.NVarChar(Max)
  branchName     String?   @map("branch_name") @db.NVarChar(150)
  accountType    String    @default("N'Current Account'", map: "DF_house_banks_account_type") @map("account_type") @db.NVarChar(50)
  currency       String    @default("N'INR'", map: "DF_house_banks_currency") @db.NVarChar(10)
  openingBalance Decimal   @default(0, map: "DF_house_banks_opening_balance") @map("opening_balance") @db.Decimal(15, 2)
  openingDate    DateTime? @map("opening_date") @db.Date
  description    String?   @db.NVarChar(Max)
  status         String    @default("N'Active'", map: "DF_house_banks_status") @db.NVarChar(20)
  isDefault      Boolean   @default(false, map: "DF_house_banks_is_default") @map("is_default")
  qrCodePath     String?   @map("qr_code_path") @db.NVarChar(500)

  @@map("house_banks")
}

model SalesEmployee {
  id                    Int               @id @default(autoincrement())
  employeeCode          String            @unique @map("employee_code") @db.NVarChar(50)
  employeeName          String            @map("employee_name") @db.NVarChar(150)
  email                 String?           @db.NVarChar(100)
  phoneNumber           String?           @map("phone_number") @db.NVarChar(20)
  dateOfJoining         DateTime?         @map("date_of_joining") @db.Date
  address               String?           @db.NVarChar(Max)
  status                String            @default("N'Active'", map: "DF_sales_employees_status") @db.NVarChar(20)
  departmentId          Int?              @map("department_id")
  signatureKey          String?           @map("signature_key") @db.NVarChar(500)
  approvalAuthorization Boolean           @default(false, map: "DF_sales_employees_approval_authorization") @map("approval_authorization")
  branchId              Int?              @map("branch_id")
  addressLine1          String?           @map("address_line1") @db.NVarChar(200)
  addressLine2          String?           @map("address_line2") @db.NVarChar(200)
  country               String?           @db.NVarChar(100)
  state                 String?           @db.NVarChar(100)
  city                  String?           @db.NVarChar(100)
  zip                   String?           @db.NVarChar(20)
  panNumber             String?           @map("pan_number") @db.NVarChar(20)
  alternateMobileNumber String?           @map("alternate_mobile_number") @db.NVarChar(20)
  payMode               String?           @map("pay_mode") @db.NVarChar(20)
  accountNumber         String?           @map("account_number") @db.NVarChar(30)
  ifscCode              String?           @map("ifsc_code") @db.NVarChar(11)
  bankBranch            String?           @map("bank_branch") @db.NVarChar(150)
  appUsers              AppUser[]
  branch                Branch?           @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_sales_employees_branch")
  department            DepartmentMaster? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_sales_employees_department")

  @@map("sales_employees")
}

model DepartmentMaster {
  id        Int             @id @default(autoincrement())
  code      String          @unique @db.NVarChar(50)
  name      String          @db.NVarChar(150)
  status    String          @default("N'Active'", map: "DF_department_master_status") @db.NVarChar(20)
  employees SalesEmployee[]

  @@map("department_master")
}

model ApprovalFlow {
  id              Int                 @id @default(autoincrement())
  transactionName String              @map("transaction_name") @db.NVarChar(100)
  approvalType    String              @default("N'Amount Based'", map: "DF_approval_flows_approval_type") @map("approval_type") @db.NVarChar(50)
  appliedFor      String              @default("N'All Branches'", map: "DF_approval_flows_applied_for") @map("applied_for") @db.NVarChar(100)
  status          String              @default("N'Active'", map: "DF_approval_flows_status") @db.NVarChar(20)
  levels          ApprovalFlowLevel[]

  @@map("approval_flows")
}

model ApprovalFlowLevel {
  id             Int           @id @default(autoincrement())
  approvalFlowId Int?          @map("approval_flow_id")
  levelName      String?       @map("level_name") @db.NVarChar(50)
  approverType   String        @default("N'User'", map: "DF_approval_flow_levels_approver_type") @map("approver_type") @db.NVarChar(50)
  approver       String?       @db.NVarChar(150)
  fromAmount     Decimal       @default(0, map: "DF_approval_flow_levels_from_amount") @map("from_amount") @db.Decimal(15, 2)
  toAmount       Decimal?      @map("to_amount") @db.Decimal(15, 2)
  requiredAction String        @default("N'Approve'", map: "DF_approval_flow_levels_required_action") @map("required_action") @db.NVarChar(20)
  levelOrder     Int           @default(1, map: "DF_approval_flow_levels_level_order") @map("level_order")
  approvalFlow   ApprovalFlow? @relation(fields: [approvalFlowId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("approval_flow_levels")
}

model AccountGroup {
  id               Int              @id @default(autoincrement()) @map("GroupID")
  groupCode        String           @unique(map: "UQ_AccountGroups_GroupCode") @map("GroupCode") @db.VarChar(20)
  groupName        String           @map("GroupName") @db.VarChar(100)
  parentGroupId    Int?             @map("ParentGroupID")
  groupType        String           @map("GroupType") @db.VarChar(30)
  groupLevel       Int              @default(1, map: "DF_AccountGroups_GroupLevel") @map("GroupLevel")
  isPostingAllowed Boolean          @default(false, map: "DF_AccountGroups_IsPostingAllowed") @map("IsPostingAllowed")
  status           String           @default("A", map: "DF_AccountGroups_Status") @map("Status") @db.Char(1)
  remarks          String?          @map("Remarks") @db.VarChar(255)
  createdBy        Int?             @map("CreatedBy")
  createdDate      DateTime         @default(now(), map: "DF_AccountGroups_CreatedDate") @map("CreatedDate") @db.DateTime
  modifiedBy       Int?             @map("ModifiedBy")
  modifiedDate     DateTime?        @map("ModifiedDate") @db.DateTime
  parentGroup      AccountGroup?    @relation("AccountGroupParent", fields: [parentGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_AccountGroups_Parent")
  childGroups      AccountGroup[]   @relation("AccountGroupParent")
  accounts         ChartOfAccount[]

  @@map("AccountGroups")
}

model AccountType {
  id                 Int              @id @default(autoincrement()) @map("AccountTypeID")
  typeCode           String           @unique(map: "UQ_AccountTypes_TypeCode") @map("TypeCode") @db.VarChar(20)
  typeName           String           @map("TypeName") @db.VarChar(50)
  normalBalance      String           @default("D", map: "DF_AccountTypes_NormalBalance") @map("NormalBalance") @db.Char(1)
  status             String           @default("A", map: "DF_AccountTypes_Status") @map("Status") @db.Char(1)
  createdBy          Int?             @map("CreatedBy")
  createdDate        DateTime         @default(now(), map: "DF_AccountTypes_CreatedDate") @map("CreatedDate") @db.DateTime
  modifiedBy         Int?             @map("ModifiedBy")
  modifiedDate       DateTime?        @map("ModifiedDate") @db.DateTime
  financialStatement String           @default("Balance Sheet", map: "DF_accounttypes_FinancialStatement") @map("FinancialStatement") @db.VarChar(30)
  accounts           ChartOfAccount[]

  @@map("AccountTypes")
}

model ChartOfAccount {
  id                                                                                                 Int                      @id @default(autoincrement()) @map("AccountID")
  accountCode                                                                                        String                   @unique(map: "UQ_ChartOfAccounts_AccountCode") @map("AccountCode") @db.VarChar(20)
  accountName                                                                                        String                   @map("AccountName") @db.VarChar(100)
  groupId                                                                                            Int?                     @map("GroupID")
  accountLevel                                                                                       Int                      @default(1, map: "DF_ChartOfAccounts_AccountLevel") @map("AccountLevel")
  status                                                                                             String                   @default("A", map: "DF_ChartOfAccounts_Status") @map("Status") @db.Char(1)
  remarks                                                                                            String?                  @map("Remarks") @db.VarChar(255)
  createdBy                                                                                          Int?                     @map("CreatedBy")
  createdDate                                                                                        DateTime                 @default(now(), map: "DF_ChartOfAccounts_CreatedDate") @map("CreatedDate") @db.DateTime
  modifiedBy                                                                                         Int?                     @map("ModifiedBy")
  modifiedDate                                                                                       DateTime?                @map("ModifiedDate") @db.DateTime
  accountTypeId                                                                                      Int?                     @map("AccountTypeID")
  currency                                                                                           String                   @default("INR", map: "DF_ChartOfAccounts_Currency") @map("Currency") @db.VarChar(10)
  openingBalance                                                                                     Decimal?                 @map("OpeningBalance") @db.Decimal(18, 2)
  balanceType                                                                                        String                   @default("D", map: "DF_ChartOfAccounts_BalanceType") @map("BalanceType") @db.Char(1)
  isControlAccount                                                                                   Boolean                  @default(false, map: "DF_ChartOfAccounts_IsControlAccount") @map("IsControlAccount")
  allowManualEntry                                                                                   Boolean                  @default(true, map: "DF_ChartOfAccounts_AllowManualEntry") @map("AllowManualEntry")
  costCenterRequired                                                                                 Boolean                  @default(false, map: "DF_ChartOfAccounts_CostCenterRequired") @map("CostCenterRequired")
  accountNature                                                                                      String                   @default("A", map: "DF_ChartOfAccounts_AccountNature") @map("AccountNature") @db.Char(1)
