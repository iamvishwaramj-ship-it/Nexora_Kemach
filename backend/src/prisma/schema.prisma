  remarks         String?               @db.NVarChar(Max)
  subtotal        Decimal               @default(0, map: "DF_delivery_challans_subtotal") @db.Decimal(15, 2)
  taxableAmount   Decimal               @default(0, map: "DF_delivery_challans_taxable_amount") @map("taxable_amount") @db.Decimal(15, 2)
  cgstAmount      Decimal               @default(0, map: "DF_delivery_challans_cgst_amount") @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount      Decimal               @default(0, map: "DF_delivery_challans_sgst_amount") @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount      Decimal               @default(0, map: "DF_delivery_challans_igst_amount") @map("igst_amount") @db.Decimal(15, 2)
  discountPercent Decimal               @default(0, map: "DF_delivery_challans_discount_percent") @map("discount_percent") @db.Decimal(5, 2)
  placeOfSupply   String?               @map("place_of_supply") @db.NVarChar(100)
  // Display-only, auto-filled from the selected customer's own Business
  // Partner Billing address (same pattern as supplierState on the purchase
  // documents) -- drives CGST/SGST vs IGST. Independent of placeOfSupply.
  customerState      String?   @map("customer_state") @db.NVarChar(100)
  roundOff        Decimal               @default(0, map: "DF_delivery_challans_round_off") @map("round_off") @db.Decimal(15, 2)
  amount          Decimal               @default(0, map: "DF_delivery_challans_amount") @db.Decimal(15, 2)
  status          String                @default("N'Pending'", map: "DF_delivery_challans_status") @db.NVarChar(50)
  // Cancel action (Actions column, with a confirm popup) — same
  // pattern/reasoning as PurchaseOrder.isCancelled/GoodsReceivedNote.isCancelled.
  // Set together with status: "Cancelled" and never on its own. Refused by
  // the cancel route while a live (non-cancelled) Sales Invoice still
  // references this challan's deliveryChallanNo — see
  // PATCH /sales/delivery-challans/:id/cancel. Once true: excluded from
  // every Copy From / "pick a source document" picker downstream (see
  // copyableChallans in SalesInvoice.jsx / SalesReturn.jsx), and
  // View/Edit/Print/Delete are blocked for it in the UI.
  isCancelled     Boolean               @default(false, map: "DF_delivery_challans_is_cancelled") @map("is_cancelled")
  // See the identical comment on GoodsReceivedNote.stockPostingGeneration.
  stockPostingGeneration Int?          @default(0, map: "DF_delivery_challans_stock_posting_generation") @map("stock_posting_generation")
  branch          String?               @db.NVarChar(150)
  tcsAmount       Decimal               @default(0, map: "DF_delivery_challans_tcs_amount") @map("tcs_amount") @db.Decimal(15, 2)
  billingType     String?               @map("billing_type") @db.NVarChar(20)
  purchaseType    String?               @map("purchase_type") @db.NVarChar(20)
  typeOfPurchase  String?               @map("type_of_purchase") @db.NVarChar(50)
  salesType       String?               @map("sales_type") @db.NVarChar(20)
  transportMode   String?               @map("transport_mode") @db.NVarChar(50)
  invoiceType     String?               @map("invoice_type") @db.NVarChar(30)
  supplier        String?               @db.NVarChar(150)
  customerRefNo   String?               @map("customer_ref_no") @db.NVarChar(50)
  preparedBy      String?               @map("prepared_by") @db.NVarChar(100)
  approvedBy      String?               @map("approved_by") @db.NVarChar(100)
  receiver        String?               @db.NVarChar(100)
  receiverPhone   String?               @map("receiver_phone") @db.NVarChar(20)
  machineryCode   String?               @map("machinery_code") @db.NVarChar(50)
  salesCategory   String?               @map("sales_category") @db.NVarChar(20)
  machineSerialNo String?               @map("machine_serial_no") @db.NVarChar(50)
  engineNo        String?               @map("engine_no") @db.NVarChar(50)
  // Required CFL-style classification of what this despatch is actually
  // for (Warranty / Good will Warranty / FOC / Goodwill FOC / attachments /
  // Claims) — required at the form layer (see deliveryChallanSchema),
  // nullable here so existing rows created before this column existed don't
  // need a backfill, same convention as salesPerson/salesType above.
  typeOfDc        String?               @map("type_of_dc") @db.NVarChar(50)
  // Shown, and required, only when typeOfDc is 'Warranty' (see the
  // superRefine on deliveryChallanSchema) -- nullable here for the same
  // reason typeOfDc itself is: no backfill needed for rows that predate the
  // column, and every non-Warranty despatch legitimately has no value.
  bobLinkNo       String?               @map("bob_link_no") @db.NVarChar(50)
  hypothecation   String?               @map("hypothecation") @db.NVarChar(150)
  roadTax           Decimal             @default(0, map: "DF_delivery_challans_road_tax") @map("road_tax") @db.Decimal(15, 2)
  roadTaxApplicable Boolean             @default(false, map: "DF_delivery_challans_road_tax_applicable") @map("road_tax_applicable")
  items           DeliveryChallanItem[]

  @@index([customer])
  @@index([orderNo])
  @@index([customer], map: "ix_delivery_challan_customer")
  @@index([status, challanDate], map: "ix_delivery_challan_status_date")
  @@index([branch], map: "ix_delivery_challan_branch")
  @@map("delivery_challans")
}

