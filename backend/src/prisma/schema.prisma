  // GoodsReceivedNote.vendorRefNo (see PurchaseOtherDetailsCard.jsx).
  vendorRefNo        String?             @map("vendor_ref_no") @db.NVarChar(50)
  currency           String              @default("N'INR'", map: "DF_purchase_orders_currency") @db.NVarChar(10)
  paymentTerms       String?             @map("payment_terms") @db.NVarChar(50)
  deliveryDate       DateTime?           @map("delivery_date") @db.Date
  shipTo             String?             @map("ship_to") @db.NVarChar(150)
  // "Ship to a different customer" toggle on the Supplier & Document
  // Details card — same feature, same shape as PurchaseInvoice's own pair of
  // columns (see the comment there): off (default) leaves shipTo deriving
  // from the selected Branch as before; on, shipTo holds the resolved (or
  // since hand-edited) text of the chosen customer's Shipping Address, and
  // these two columns exist only so the form can correctly re-show which
  // mode/customer was used when the order is reopened for edit. shipTo
  // itself is always the final text the print template reads.
  shipToDifferentCustomer Boolean        @default(false, map: "DF_purchase_orders_ship_to_diff_customer") @map("ship_to_different_customer")
  // Same shape as `supplier` above: the Business Partner's name, not a
  // numeric id — matches PurchaseInvoice.shipToCustomer's convention.
  shipToCustomer     String?             @map("ship_to_customer") @db.NVarChar(100)
  termsConditions    String?             @map("terms_conditions") @db.NVarChar(Max)
  attachmentName     String?             @map("attachment_name") @db.NVarChar(255)
  discountPercent    Decimal             @default(0, map: "DF_purchase_orders_discount_percent") @map("discount_percent") @db.Decimal(5, 2)
  subtotal           Decimal             @default(0, map: "DF_purchase_orders_subtotal") @db.Decimal(15, 2)
  taxableAmount      Decimal             @default(0, map: "DF_purchase_orders_taxable_amount") @map("taxable_amount") @db.Decimal(15, 2)
  cgstAmount         Decimal             @default(0, map: "DF_purchase_orders_cgst_amount") @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount         Decimal             @default(0, map: "DF_purchase_orders_sgst_amount") @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount         Decimal             @default(0, map: "DF_purchase_orders_igst_amount") @map("igst_amount") @db.Decimal(15, 2)
  roundOff           Decimal             @default(0, map: "DF_purchase_orders_round_off") @map("round_off") @db.Decimal(15, 2)
  amount             Decimal             @default(0, map: "DF_purchase_orders_amount") @db.Decimal(15, 2)
  status             String              @default("N'Open'", map: "DF_purchase_orders_status") @db.NVarChar(20)
  // Cancel action (Actions column, with a confirm popup) — set together with
  // status: "Cancelled" and never on its own. Kept as its own column rather
  // than inferring cancellation from status === 'Cancelled' alone so a
  // cancelled order stays unambiguous even if `status` is ever driven by
  // something else later. Once true: the order is excluded from every Copy
  // From / "pick a source document" picker downstream (see
  // copyablePurchaseOrders in PurchaseGRN.jsx), and View/Edit/Print are
  // blocked for it in the UI — see PurchaseOrder.jsx's row actions.
  isCancelled        Boolean             @default(false, map: "DF_purchase_orders_is_cancelled") @map("is_cancelled")
  buyingBranch       String?             @map("buying_branch") @db.NVarChar(150)
  department         String?             @db.NVarChar(100)
  placeOfSupply      String?             @map("place_of_supply") @db.NVarChar(100)
  transportMode      String?             @map("transport_mode") @db.NVarChar(50)
  eWayBillNo         String?             @map("e_way_bill_no") @db.NVarChar(50)
  eWayBillDate       DateTime?           @map("e_way_bill_date") @db.Date
  packingForwarding  String?             @map("packing_forwarding") @db.NVarChar(150)
  loadingUnloading   String?             @map("loading_unloading") @db.NVarChar(150)
  inspection         String?             @db.NVarChar(150)
  warranty           String?             @db.NVarChar(Max)
  remarks            String?             @db.NVarChar(Max)
  bankAccount        String?             @map("bank_account") @db.NVarChar(150)
  preparedBy         String?             @map("prepared_by") @db.NVarChar(100)
  checkedBy          String?             @map("checked_by") @db.NVarChar(100)
  approvedBy         String?             @map("approved_by") @db.NVarChar(100)
  branch             String?             @db.NVarChar(150)
  quotationNo        String?             @map("quotation_no") @db.NVarChar(50)
  shipFrom           String?             @map("ship_from") @db.NVarChar(150)
  // Display-only, auto-filled from the selected supplier's own Business
  // Partner Billing address — see supplierState in PurchaseOrder.jsx.
  // Independent of placeOfSupply above, which tracks the branch's state.
  supplierState      String?             @map("supplier_state") @db.NVarChar(100)
  billingType        String?             @map("billing_type") @db.NVarChar(20)
  purchaseType       String?             @map("purchase_type") @db.NVarChar(20)
  salesType          String?             @map("sales_type") @db.NVarChar(20)
  typeOfPurchase     String?             @map("type_of_purchase") @db.NVarChar(50)
  purchaseEmployee   String?             @map("purchase_employee") @db.NVarChar(100)
  invoiceType        String?             @map("invoice_type") @db.NVarChar(150)
  tcsAmount          Decimal             @default(0, map: "DF_purchase_orders_tcs_amount") @map("tcs_amount") @db.Decimal(15, 2)
  vehicle_type       String?             @db.NVarChar(20)
  roadTax            Decimal             @default(0, map: "DF_purchase_orders_road_tax") @map("road_tax") @db.Decimal(15, 2)
  freightTransportId Int?                @map("freight_transport_id")
  freightName        String?             @map("freight_name") @db.NVarChar(150)
  freightRemarks     String?             @map("freight_remarks") @db.NVarChar(Max)
  freightTaxCodeId   Int?                @map("freight_tax_code_id")
  freightTaxAmount   Decimal             @default(0, map: "DF_purchase_orders_freight_tax_amount") @map("freight_tax_amount") @db.Decimal(15, 2)
  freightNetAmount   Decimal             @default(0, map: "DF_purchase_orders_freight_net_amount") @map("freight_net_amount") @db.Decimal(15, 2)
  freightGrossAmount Decimal             @default(0, map: "DF_purchase_orders_freight_gross_amount") @map("freight_gross_amount") @db.Decimal(15, 2)
  items              PurchaseOrderItem[]

  @@index([supplier])
  @@index([quotationNo], map: "ix_purchase_orders_quotation_no")
  @@index([status, poDate], map: "IX_PurchaseOrder_Status_PoDate")
  @@index([supplier], map: "IX_PurchaseOrder_Supplier")
  @@index([branch], map: "ix_purchase_order_branch")
  @@map("purchase_orders")
}

