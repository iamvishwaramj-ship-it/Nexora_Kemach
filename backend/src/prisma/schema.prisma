  machineSerialNo    String?            @map("machine_serial_no") @db.NVarChar(50)
  engineNo           String?            @map("engine_no") @db.NVarChar(50)
  hypothecation      String?            @map("hypothecation") @db.NVarChar(150)
  roadTax            Decimal            @default(0, map: "DF_sales_invoices_road_tax") @map("road_tax") @db.Decimal(15, 2)
  freightTransportId Int?               @map("freight_transport_id")
  freightName        String?            @map("freight_name") @db.NVarChar(150)
  freightRemarks     String?            @map("freight_remarks") @db.NVarChar(Max)
  freightTaxCodeId   Int?               @map("freight_tax_code_id")
