model ProductBatch {
  id                 Int                    @id(map: "PK_product_batches") @default(autoincrement())
  batchNo            String                 @map("batch_no") @db.NVarChar(100)
  productCode        String                 @map("product_code") @db.NVarChar(50)
  quantity           Decimal                @default(0, map: "DF_product_batches_quantity") @db.Decimal(15, 2)
  batchAttribute1    String?                @map("batch_attribute_1") @db.NVarChar(100)
  batchAttribute2    String?                @map("batch_attribute_2") @db.NVarChar(100)
  expirationDate     DateTime?              @map("expiration_date") @db.Date
  mfrDate            DateTime?              @map("mfr_date") @db.Date
  admissionDate      DateTime?              @map("admission_date") @db.Date
  location           String?                @db.NVarChar(150)
  warehouse          String?                @db.NVarChar(150)
  details            String?                @db.NVarChar(Max)
  status             String                 @default("Active", map: "DF_product_batches_status") @db.NVarChar(20)
  grnItemId          Int?                   @map("grn_item_id")
  createdAt          DateTime               @default(now(), map: "DF_product_batches_created_at") @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  stockReceiptItemId Int?                   @map("stock_receipt_item_id")
  // Purchase Invoice, when it is the direct (no base GRN) document, creates
  // its own batches exactly like GRN/Stock Receipt do — see the 'purchaseInvoice'
  // batchScope on assertUniqueBatchesAndSerials in utils/businessRules.js.
  purchaseInvoiceItemId Int?                @map("purchase_invoice_item_id")
  grnItem            GoodsReceivedNoteItem? @relation(fields: [grnItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_product_batches_grn_item")
  stockReceiptItem   StockReceiptItem?      @relation(fields: [stockReceiptItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_product_batches_stock_receipt_item")
  purchaseInvoiceItem PurchaseInvoiceItem?  @relation(fields: [purchaseInvoiceItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_product_batches_purchase_invoice_item")

  // Unique per (batch, warehouse, product) rather than just (batch,
  // warehouse) — a Purchase GRN's batch duplicate check is scoped to the
  // GRN document itself (see assertUniqueBatchesAndSerials's 'grn'
  // batchScope in utils/businessRules.js), so the same batch number is
  // explicitly allowed on more than one line of the SAME GRN for
  // different products sharing a warehouse. Scoping uniqueness to include
  // productCode keeps exactly one row per product's own running quantity
  // of a batch in a warehouse (still what findBatchRow/updateBatchQuantity
  // and every Batch Selection/Stock Transfer/Sales Return flow depend on),
  // while no longer colliding when two different products' lines on one
  // GRN legitimately name the same batch+warehouse. See migration
  // 20260925060000_batch_warehouse_product_composite_unique.
  @@unique([batchNo, warehouse, productCode], map: "UQ_product_batches_batch_no_warehouse_product")
  @@index([batchNo, warehouse], map: "IX_product_batches_batch_no_warehouse")
  @@index([productCode], map: "IX_product_batches_product")
  @@map("product_batches")
}

