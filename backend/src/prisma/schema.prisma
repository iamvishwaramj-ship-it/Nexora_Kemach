model GoodsReceivedNote {
  id                 Int                     @id @default(autoincrement())
  grnNo              String                  @unique @map("grn_no") @db.NVarChar(50)
  poNo               String?                 @map("po_no") @db.NVarChar(50)
  poDate             DateTime?               @map("po_date") @db.Date
  supplier           String?                 @db.NVarChar(100)
  receivedDate       DateTime?               @map("received_date") @db.Date
  deliveryChallanNo  String?                 @map("delivery_challan_no") @db.NVarChar(50)
  challanDate        DateTime?               @map("challan_date") @db.Date
  deliveryDate       DateTime?               @map("delivery_date") @db.Date
  warehouse          String?                 @db.NVarChar(150)
  receivedBy         String?                 @map("received_by") @db.NVarChar(100)
  notes              String?                 @db.NVarChar(Max)
  termsConditions    String?                 @map("terms_conditions") @db.NVarChar(Max)
  attachmentName     String?                 @map("attachment_name") @db.NVarChar(255)
  totalItems         Int                     @default(0, map: "DF_goods_received_notes_total_items") @map("total_items")
  subtotal           Decimal                 @default(0, map: "DF_goods_received_notes_subtotal") @db.Decimal(15, 2)
  cgstAmount         Decimal                 @default(0, map: "DF_goods_received_notes_cgst_amount") @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount         Decimal                 @default(0, map: "DF_goods_received_notes_sgst_amount") @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount         Decimal                 @default(0, map: "DF_goods_received_notes_igst_amount") @map("igst_amount") @db.Decimal(15, 2)
  roundOff           Decimal                 @default(0, map: "DF_goods_received_notes_round_off") @map("round_off") @db.Decimal(15, 2)
  taxableAmount      Decimal                 @default(0, map: "DF_goods_received_notes_taxable_amount") @map("taxable_amount") @db.Decimal(15, 2)
  discountPercent    Decimal                 @default(0, map: "DF_goods_received_notes_discount_percent") @map("discount_percent") @db.Decimal(5, 2)
  placeOfSupply      String?                 @map("place_of_supply") @db.NVarChar(100)
  amount             Decimal                 @default(0, map: "DF_goods_received_notes_amount") @db.Decimal(15, 2)
  status             String                  @default("N'Open'", map: "DF_goods_received_notes_status") @db.NVarChar(50)
  // Cancel action (Actions column, with a confirm popup) — set together with
  // status: "Cancelled" and never on its own, same pattern/reasoning as
  // PurchaseOrder.isCancelled above. Once true: the GRN is excluded from
  // every Copy From / "pick a source document" picker downstream (see
  // copyableGrns in PurchaseInvoice.jsx / PurchaseReturn.jsx), and
  // View/Edit/Print/Delete are blocked for it in the UI — see
  // PurchaseGRN.jsx's row actions. Unlike a Purchase Order, a GRN can have
  // already posted stock and a G/L entry by the time it's cancelled — the
  // cancel route reverses both (via syncStockPosting/syncJournalEntry,
  // which already treat 'Cancelled' as a non-moving status) rather than
  // just flipping this flag.
  isCancelled        Boolean                 @default(false, map: "DF_goods_received_notes_is_cancelled") @map("is_cancelled")
  // Which generation of stock posting is currently live for this document --
  // 0 means never posted. Lets syncStockPosting tell "first post" (0 -> 1,
  // nothing to reverse) apart from "repost after an edit" (reverse the
  // generation stored here, then post the next one), while the append-only
  // Stock journal keeps every generation's rows forever (see Stock.postGeneration).
  stockPostingGeneration Int?               @default(0, map: "DF_goods_received_notes_stock_posting_generation") @map("stock_posting_generation")
  branch             String?                 @db.NVarChar(150)
  vendorRefNo        String?                 @map("vendor_ref_no") @db.NVarChar(50)
  shipFrom           String?                 @map("ship_from") @db.NVarChar(255)
  // Display-only, auto-filled from the selected supplier's own Business
  // Partner Billing address — see supplierState in PurchaseGRN.jsx.
  // Independent of placeOfSupply above, which tracks a different concept.
  supplierState      String?                 @map("supplier_state") @db.NVarChar(100)
  shipTo             String?                 @map("ship_to") @db.NVarChar(255)
  // "Ship to a different customer" toggle — same feature/shape as
  // PurchaseInvoice.shipToDifferentCustomer/shipToCustomer and
  // PurchaseOrder's own pair above.
  shipToDifferentCustomer Boolean            @default(false, map: "DF_goods_received_notes_ship_to_diff_customer") @map("ship_to_different_customer")
  shipToCustomer     String?                 @map("ship_to_customer") @db.NVarChar(100)
  billingType        String?                 @map("billing_type") @db.NVarChar(20)
  purchaseType       String?                 @map("purchase_type") @db.NVarChar(20)
  typeOfPurchase     String?                 @map("type_of_purchase") @db.NVarChar(50)
  salesType          String?                 @map("sales_type") @db.NVarChar(20)
  purchaseEmployee   String?                 @map("purchase_employee") @db.NVarChar(100)
  transportMode      String?                 @map("transport_mode") @db.NVarChar(50)
  invoiceType        String?                 @map("invoice_type") @db.NVarChar(150)
  tcsAmount          Decimal                 @default(0, map: "DF_goods_received_notes_tcs_amount") @map("tcs_amount") @db.Decimal(15, 2)
  preparedBy         String?                 @map("prepared_by") @db.NVarChar(100)
  approvedBy         String?                 @map("approved_by") @db.NVarChar(100)
  roadTax            Decimal                 @default(0, map: "DF_goods_received_notes_road_tax") @map("road_tax") @db.Decimal(15, 2)
  freightTransportId Int?                    @map("freight_transport_id")
  freightName        String?                 @map("freight_name") @db.NVarChar(150)
  freightRemarks     String?                 @map("freight_remarks") @db.NVarChar(Max)
  freightTaxCodeId   Int?                    @map("freight_tax_code_id")
  freightTaxAmount   Decimal                 @default(0, map: "DF_goods_received_notes_freight_tax_amount") @map("freight_tax_amount") @db.Decimal(15, 2)
  freightNetAmount   Decimal                 @default(0, map: "DF_goods_received_notes_freight_net_amount") @map("freight_net_amount") @db.Decimal(15, 2)
  freightGrossAmount Decimal                 @default(0, map: "DF_goods_received_notes_freight_gross_amount") @map("freight_gross_amount") @db.Decimal(15, 2)
  items              GoodsReceivedNoteItem[]

  @@index([supplier])
  @@index([poNo])
  @@index([status, receivedDate], map: "ix_grn_status_date")
  @@index([supplier], map: "ix_grn_supplier")
  @@index([branch], map: "ix_grn_branch")
  @@map("goods_received_notes")
}

model SalesReturn {
