model PurchaseCreditMemo {
  id                 Int                      @id @default(autoincrement())
  creditNo           String                   @unique @map("credit_no") @db.NVarChar(50)
  status             String                   @default("Open", map: "DF_pcm_status") @db.NVarChar(50)
  // Cancel action (Actions column, with a confirm popup) — same
  // pattern/reasoning as PurchaseOrder.isCancelled/GoodsReceivedNote.isCancelled.
  // Set together with status: "Cancelled" and never on its own. Once true:
  // View/Edit/Print/Delete are blocked for it in the UI — see
  // PurchaseCreditMemo.jsx's row actions. Nothing downstream is ever raised
  // against a Purchase Credit Memo, so no Copy From picker needs to exclude
  // it — unlike GoodsReceivedNote.isCancelled/PurchaseInvoice.isCancelled.
  isCancelled        Boolean                  @default(false, map: "DF_purchase_credit_memos_is_cancelled") @map("is_cancelled")
  // See the identical comment on GoodsReceivedNote.stockPostingGeneration.
  stockPostingGeneration Int?                 @default(0, map: "DF_purchase_credit_memos_stock_posting_generation") @map("stock_posting_generation")
  invoiceNo          String?                  @map("invoice_no") @db.NVarChar(50)
  supplier           String?                  @db.NVarChar(100)
  supplierName       String?                  @map("supplier_name") @db.NVarChar(150)
  supplierCode       String?                  @map("supplier_code") @db.NVarChar(50)
  // contactPerson/supplierRefNo/transactionType were dropped in migration
  // 20260919060100, together with their inputs on the header card. Nothing
  // outside that form ever read them — no GL posting, no print layout, no
  // list column, no report — which is exactly why they were the only three
  // of the nine fields removed from the card that were safe to delete
  // outright. The others (location, postingDate, billDoNo, billDoDate,
  // reason, status) also left the card but are still columns here, because
  // each is load-bearing somewhere the form is not: see the header card's
  // own comment in PurchaseCreditMemo.jsx for which does what.
  location           String?                  @db.NVarChar(150)
  branch             String?                  @db.NVarChar(150)
  documentDate       DateTime?                @map("document_date") @db.Date
  postingDate        DateTime?                @map("posting_date") @db.Date
  dueDate            DateTime?                @map("due_date") @db.Date
  paymentTerms       String?                  @map("payment_terms") @db.NVarChar(50)
  billDoNo           String?                  @map("bill_do_no") @db.NVarChar(50)
  billDoDate         DateTime?                @map("bill_do_date") @db.Date
  reason             String?                  @db.NVarChar(Max)
  comments           String?                  @db.NVarChar(Max)
  // Added in migration 20260919060000 so the credit memo's header card can
  // carry the same fields the rest of the purchase documents already do.
  // Types mirror PurchaseInvoice's own columns exactly (billFrom/shipTo are
  // NVarChar(Max) there because a formatted multi-line address outgrows a
  // fixed width), and the Other Details five match PurchaseOrder's.
  //
  // currency is nullable with no database default, unlike PurchaseOrder/
  // PurchaseInvoice where it is NOT NULL: those two were created with the
  // column, this one is adding it to a table that already holds rows, and a
  // nullable column needs no backfill. The form still defaults it to INR.
  //
  // billingType is deliberately absent: PurchaseOtherDetailsCard hides that
  // field for every document, so adding a column here would create one that
  // nothing can ever write. If that card is ever changed to show Billing
  // Type again, this model needs the column before this document can.
  currency           String?                  @db.NVarChar(10)
  billFrom           String?                  @map("bill_from") @db.NVarChar(Max)
  shipTo             String?                  @map("ship_to") @db.NVarChar(Max)
  purchaseType       String?                  @map("purchase_type") @db.NVarChar(20)
  typeOfPurchase     String?                  @map("type_of_purchase") @db.NVarChar(50)
  salesType          String?                  @map("sales_type") @db.NVarChar(20)
  purchaseEmployee   String?                  @map("purchase_employee") @db.NVarChar(100)
  transportMode      String?                  @map("transport_mode") @db.NVarChar(50)
  // Vendor's own reference for this credit memo — same field/name as every
  // other purchase document's own vendorRefNo (see
  // PurchaseOtherDetailsCard.jsx).
  vendorRefNo        String?                  @map("vendor_ref_no") @db.NVarChar(50)
  termsConditions    String?                  @map("terms_conditions") @db.NVarChar(Max)
  attachmentName     String?                  @map("attachment_name") @db.NVarChar(255)
  placeOfSupply      String?                  @map("place_of_supply") @db.NVarChar(100)
  // Display-only, auto-filled from the selected supplier's own Business
  // Partner Billing address (same as Purchase Order/GRN/Invoice) -- drives
  // CGST/SGST vs IGST. Independent of placeOfSupply above.
  supplierState      String?   @map("supplier_state") @db.NVarChar(100)
  totalItems         Int                      @default(0, map: "DF_pcm_total_items") @map("total_items")
  discountPercent    Decimal                  @default(0, map: "DF_pcm_discount_percent") @map("discount_percent") @db.Decimal(5, 2)
  subtotal           Decimal                  @default(0, map: "DF_pcm_subtotal") @db.Decimal(15, 2)
  taxableAmount      Decimal                  @default(0, map: "DF_pcm_taxable_amount") @map("taxable_amount") @db.Decimal(15, 2)
  cgstAmount         Decimal                  @default(0, map: "DF_pcm_cgst_amount") @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount         Decimal                  @default(0, map: "DF_pcm_sgst_amount") @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount         Decimal                  @default(0, map: "DF_pcm_igst_amount") @map("igst_amount") @db.Decimal(15, 2)
  roundOff           Decimal                  @default(0, map: "DF_pcm_round_off") @map("round_off") @db.Decimal(15, 2)
  amount             Decimal                  @default(0, map: "DF_pcm_amount") @db.Decimal(15, 2)
  warehouse          String?                  @db.NVarChar(150)
  tcsAmount          Decimal                  @default(0, map: "DF_purchase_credit_memos_tcs_amount") @map("tcs_amount") @db.Decimal(15, 2)
  preparedBy         String?                  @map("prepared_by") @db.NVarChar(100)
  approvedBy         String?                  @map("approved_by") @db.NVarChar(100)
  roadTax            Decimal                  @default(0, map: "DF_purchase_credit_memos_road_tax") @map("road_tax") @db.Decimal(15, 2)
  freightTransportId Int?                     @map("freight_transport_id")
  freightName        String?                  @map("freight_name") @db.NVarChar(150)
  freightRemarks     String?                  @map("freight_remarks") @db.NVarChar(Max)
  freightTaxCodeId   Int?                     @map("freight_tax_code_id")
  freightTaxAmount   Decimal                  @default(0, map: "DF_purchase_credit_memos_freight_tax_amount") @map("freight_tax_amount") @db.Decimal(15, 2)
  freightNetAmount   Decimal                  @default(0, map: "DF_purchase_credit_memos_freight_net_amount") @map("freight_net_amount") @db.Decimal(15, 2)
  freightGrossAmount Decimal                  @default(0, map: "DF_purchase_credit_memos_freight_gross_amount") @map("freight_gross_amount") @db.Decimal(15, 2)
  items              PurchaseCreditMemoItem[]

  @@index([status, documentDate], map: "ix_purchase_credit_memo_status_date")
  @@index([supplier], map: "ix_purchase_credit_memo_supplier")
  @@index([invoiceNo], map: "ix_purchase_credit_memos_invoice_no")
  @@index([branch], map: "ix_purchase_credit_memo_branch")
  @@map("purchase_credit_memos")
}

