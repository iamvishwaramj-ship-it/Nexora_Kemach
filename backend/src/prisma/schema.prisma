model StockTransferRequest {
  id             Int                        @id @default(autoincrement())
  branch         String?                    @db.NVarChar(150)
  requestNo      String                     @unique @map("request_no") @db.NVarChar(50)
  status         String                     @default("Open", map: "DF_str_status") @db.NVarChar(50)
  partyCode      String?                    @map("party_code") @db.NVarChar(50)
  partyName      String?                    @map("party_name") @db.NVarChar(150)
  contactPerson  String?                    @map("contact_person") @db.NVarChar(100)
  project        String?                    @db.NVarChar(100)
  requestDate    DateTime?                  @map("request_date") @db.Date
  documentDate   DateTime?                  @map("document_date") @db.Date
  preparedBy     String?                    @map("prepared_by") @db.NVarChar(150)
  remarks        String?                    @db.NVarChar(Max)
  attachmentName String?                    @map("attachment_name") @db.NVarChar(255)
  amount         Decimal                    @default(0, map: "DF_str_amount") @db.Decimal(15, 2)
  transferType   String                     @default("Stock Transfer", map: "DF_str_transfer_type") @map("transfer_type") @db.NVarChar(50)
  toBranch       String?                    @map("to_branch") @db.NVarChar(150)
  approvalStatus String                     @default("Pending", map: "DF_stock_transfer_requests_approval_status") @map("approval_status") @db.NVarChar(20)
  approverId     Int?                       @map("approver_id")
  approvedAt     DateTime?                  @map("approved_at")
  // The user who raised the request -- lets the approver's decision be
  // notified back to them and keeps them out of their own recipient list.
  // NULL on rows created before this column existed.
  createdById    Int?                       @map("created_by_id")
  // GST totals — same subtotal/taxableAmount/cgstAmount/sgstAmount/
  // igstAmount/tcsAmount/roundOff shape every Sales/Purchase document uses
  // (see headerTotals in routes/resources.js). `amount` above stays the
  // grand total (tax-inclusive), same column every other totals-bearing
  // document already uses it for.
  subtotal       Decimal                    @default(0, map: "DF_stock_transfer_requests_subtotal") @db.Decimal(15, 2)
  taxableAmount  Decimal                    @default(0, map: "DF_stock_transfer_requests_taxable_amount") @map("taxable_amount") @db.Decimal(15, 2)
  cgstAmount     Decimal                    @default(0, map: "DF_stock_transfer_requests_cgst_amount") @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount     Decimal                    @default(0, map: "DF_stock_transfer_requests_sgst_amount") @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount     Decimal                    @default(0, map: "DF_stock_transfer_requests_igst_amount") @map("igst_amount") @db.Decimal(15, 2)
  tcsAmount      Decimal                    @default(0, map: "DF_stock_transfer_requests_tcs_amount") @map("tcs_amount") @db.Decimal(15, 2)
  roundOff       Decimal                    @default(0, map: "DF_stock_transfer_requests_round_off") @map("round_off") @db.Decimal(15, 2)
  items          StockTransferRequestItem[]
  approver       AppUser?                   @relation("StockTransferRequestApprover", fields: [approverId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_stock_transfer_requests_approver")
  createdBy      AppUser?                   @relation("StockTransferRequestCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_stock_transfer_requests_created_by")

  @@index([createdById], map: "ix_stock_transfer_request_created_by")
  @@index([branch], map: "ix_stock_transfer_request_branch")
  @@index([toBranch], map: "ix_stock_transfer_request_to_branch")
  @@map("stock_transfer_requests")
}

