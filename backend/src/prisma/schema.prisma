model JournalEntry {
  id                Int                @id @default(autoincrement())
  journalEntryNo    String             @unique @map("journal_entry_no") @db.NVarChar(50)
  branch            String?            @db.NVarChar(150)
  postingDate       DateTime?          @map("posting_date") @db.Date
  documentDate      DateTime?          @map("document_date") @db.Date
  dueDate           DateTime?          @map("due_date") @db.Date
  referenceNo       String?            @map("reference_no") @db.NVarChar(100)
  currency          String             @default("INR", map: "DF_je_currency") @db.NVarChar(10)
  exchangeRate      Decimal            @default(1, map: "DF_je_exchange_rate") @map("exchange_rate") @db.Decimal(10, 4)
  remarks           String?            @db.NVarChar(Max)
  totalDebit        Decimal            @default(0, map: "DF_je_total_debit") @map("total_debit") @db.Decimal(15, 2)
  totalCredit       Decimal            @default(0, map: "DF_je_total_credit") @map("total_credit") @db.Decimal(15, 2)
  status            String             @default("Draft", map: "DF_je_status") @db.NVarChar(20)
  transactionType   String             @default("Manual", map: "DF_je_transaction_type") @map("transaction_type") @db.NVarChar(50)
  sourceType        String?            @map("source_type") @db.NVarChar(50)
  sourceDocNo       String?            @map("source_doc_no") @db.NVarChar(50)
  glError           String?            @map("gl_error") @db.NVarChar(Max)
  ref1              String?            @map("ref_1") @db.NVarChar(100)
  ref2              String?            @map("ref_2") @db.NVarChar(100)
  ref3              String?            @map("ref_3") @db.NVarChar(100)
  reviseDateEnabled Boolean            @default(false, map: "DF_journal_entries_revise_date_enabled") @map("revise_date_enabled")
  reviseDate        DateTime?          @map("revise_date") @db.Date
  originNo          String?            @map("origin_no") @db.NVarChar(50)
  narration         String?            @db.NVarChar(Max)
  // Reversal linkage -- see reverseJournalEntry in utils/glPosting.js.
  // Cancelling a document that already posted a real (non-Pending-G/L) entry
  // no longer deletes it: the original is kept, flipped to status "Reversed",
  // and pointed at a brand-new entry that mirrors every line with debit/
  // credit swapped. `reversedEntryId` lives ONLY on the original, `isReversal`
  // is true ONLY on the mirrored entry -- one FK column carries both
  // directions: `reversedEntry` walks original -> its reversal, `reversalOf`
  // (the implicit back-relation, no scalar column of its own) walks the
  // reversal -> back to the original it reverses. Kept as a plain @unique
  // rather than a second `reversalOfId` column so the two rows can never
  // point at two different partners.
  reversedEntryId   Int?               @unique @map("reversed_entry_id")
  isReversal        Boolean            @default(false, map: "DF_je_is_reversal") @map("is_reversal")
  reversedEntry     JournalEntry?      @relation("JournalEntryReversal", fields: [reversedEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversalOf        JournalEntry?      @relation("JournalEntryReversal")
  lines             JournalEntryLine[]

  @@index([status, postingDate], map: "ix_journal_entry_status_date")
  @@index([branch], map: "ix_journal_entry_branch")
  // NOTE: (sourceType, sourceDocNo) also carries a FILTERED unique index --
  // UQ_journal_entries_source, added in migration 20260823130000_add_gl_posting
  // and widened in 20260928120000_add_journal_entry_reversal to
  // "WHERE source_type IS NOT NULL AND source_doc_no IS NOT NULL AND
  // is_reversal = 0 AND status <> 'Reversed'" (at most one LIVE, non-reversal
  // entry per source document, unlimited history rows once a document has
  // been reversed). Prisma's SQL Server connector cannot express a
  // multi-condition filtered index declaratively, so -- same as before this
  // change -- it exists only in the raw migration SQL, not as an `@@unique`
  // here; see reverseJournalEntry/postJournalEntry in utils/glPosting.js for
  // the application-level guarantee this backs.
  @@map("journal_entries")
}

model JournalEntryLine {
  id                  Int           @id @default(autoincrement())
  journalEntryId      Int?          @map("journal_entry_id")
  lineNo              Int           @default(1, map: "DF_jel_line_no") @map("line_no")
  accountCode         String        @map("account_code") @db.VarChar(20)
  accountName         String?       @map("account_name") @db.NVarChar(150)
  description         String?       @db.NVarChar(Max)
  branch              String?       @db.NVarChar(100)
  debit               Decimal       @default(0, map: "DF_jel_debit") @db.Decimal(15, 2)
  credit              Decimal       @default(0, map: "DF_jel_credit") @db.Decimal(15, 2)
  businessPartnerCode String?       @map("business_partner_code") @db.NVarChar(50)
  businessPartnerName String?       @map("business_partner_name") @db.NVarChar(150)
  debitSc             Decimal       @default(0, map: "DF_journal_entry_lines_debit_sc") @map("debit_sc") @db.Decimal(15, 2)
  creditSc            Decimal       @default(0, map: "DF_journal_entry_lines_credit_sc") @map("credit_sc") @db.Decimal(15, 2)
  baseAmount          Decimal       @default(0, map: "DF_journal_entry_lines_base_amount") @map("base_amount") @db.Decimal(15, 2)
  ref1                String?       @map("ref_1") @db.NVarChar(100)
  ref2                String?       @map("ref_2") @db.NVarChar(100)
  ref3                String?       @map("ref_3") @db.NVarChar(100)
  warehouse           String?       @db.NVarChar(150)
  journalEntry        JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("journal_entry_lines")
}

