  freightNetAmount   Decimal            @default(0, map: "DF_sales_invoices_freight_net_amount") @map("freight_net_amount") @db.Decimal(15, 2)
  freightGrossAmount Decimal            @default(0, map: "DF_sales_invoices_freight_gross_amount") @map("freight_gross_amount") @db.Decimal(15, 2)

  // TaxPro GSP e-invoice / e-way bill integration (SalesInvoice.jsx "E-Invoice
  // / E-Way Bill" tab, services/taxproGsp.service.js). Both sub-sections are
  // independent — an invoice can have an e-way bill without an IRN (e.g.
  // exempt supply) or vice versa — so each gets its own status column rather
  // than one shared "e-doc status".
  irn                   String?  @db.NVarChar(64)
  ackNo                 String?  @map("ack_no") @db.NVarChar(50)
  ackDate               DateTime? @map("ack_date")
  qrCode                String?  @map("qr_code") @db.NVarChar(Max)
  einvoiceStatus        String   @default("N'Not Generated'", map: "DF_sales_invoices_einvoice_status") @map("einvoice_status") @db.NVarChar(20)
  einvoiceCancelReason  String?  @map("einvoice_cancel_reason") @db.NVarChar(200)
  ewayBillNo            String?  @map("eway_bill_no") @db.NVarChar(20)
  ewayBillDate          DateTime? @map("eway_bill_date")
  ewayBillValidUpto     DateTime? @map("eway_bill_valid_upto")
  transporterName       String?  @map("transporter_name") @db.NVarChar(150)
  transporterGstin      String?  @map("transporter_gstin") @db.NVarChar(15)
  vehicleNo             String?  @map("vehicle_no") @db.NVarChar(20)
  ewayDistanceKm        Int?     @map("eway_distance_km")
  ewayBillStatus        String   @default("N'Not Generated'", map: "DF_sales_invoices_eway_bill_status") @map("eway_bill_status") @db.NVarChar(20)
  ewayCancelReason      String?  @map("eway_cancel_reason") @db.NVarChar(200)

  items              SalesInvoiceItem[]

  @@index([customer])
  @@index([branch, status], map: "ix_sales_invoice_branch_status")
  @@index([invoiceDate, status], map: "ix_sales_invoice_date_status")
  @@index([deliveryChallanNo, status, invoiceDate], map: "ix_sales_invoices_direct")
  @@index([customer], map: "IX_SalesInvoice_Customer")
  @@index([status, invoiceDate], map: "IX_SalesInvoice_Status_InvoiceDate")
  @@index([orderNo])
  @@map("sales_invoices")
}

