  freightNetAmount   Decimal           @default(0, map: "DF_sales_returns_freight_net_amount") @map("freight_net_amount") @db.Decimal(15, 2)
  freightGrossAmount Decimal           @default(0, map: "DF_sales_returns_freight_gross_amount") @map("freight_gross_amount") @db.Decimal(15, 2)
