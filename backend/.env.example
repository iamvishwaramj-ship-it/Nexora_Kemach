FRONTEND_URL=http://localhost:3101
NODE_ENV=development
PORT=5001
JWT_ACCESS_SECRET=replace_with_strong_random_secret
JWT_REFRESH_SECRET=replace_with_strong_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OCI Object Storage (company/tenant logo uploads) — S3-compatible API.
# Endpoint used: https://<OCI_NAMESPACE>.compat.objectstorage.<OCI_REGION>.oraclecloud.com
OCI_NAMESPACE=your_object_storage_namespace
OCI_REGION=ap-hyderabad-1
OCI_BUCKET=your_bucket_name
OCI_ACCESS_KEY=replace_with_customer_secret_key_access_key
OCI_SECRET_KEY=replace_with_customer_secret_key_secret
